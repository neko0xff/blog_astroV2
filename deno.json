{
  "tasks": {
    "clean": "deno run -A npm:rimraf ./dist ./node_modules",
    "start": "deno run -A --unstable-ffi --unstable-kv npm:astro dev",
    "dev": "deno run -A --unstable-ffi --unstable-kv npm:astro dev",
    "preview": "deno run -A npm:astro preview --host 0.0.0.0 ",
    "serve": "deno run --allow-net --allow-read --allow-env dist/server.ts",
    "build": "deno run -A --unstable-ffi --unstable-kv npm:astro build && deno run -A scripts/precompress.ts",
    "check": "deno run -A --unstable-ffi --unstable-kv npm:astro check",
    "sync": "deno run -A npm:astro sync",
    "pagefind": "deno run -A npm:pagefind --site dist --include-characters \"[]{}\\<>~\"",
    "outdated:check": "deno outdated --latest",
    "outdated:update": "deno outdated --update --latest",
    "bench": "deno bench -A --unstable-kv --unstable-ffi  bench/*",
    "install": "deno install --allow-scripts && bash scripts/patch-vite-nonascii.sh",
    "test": "deno test --allow-net",
    "lint": "deno lint --fix",
    "fmt": "deno fmt",
    "format": "deno run -A npm:prettier --write .",
    "format:check": "deno run -A npm:prettier --check .",
    "deploy:test": "deno deploy --app neko-0xff-blog",
    "deploy:release": "deno deploy --app neko-0xff-blog --prod"
  },
  "nodeModulesDir": "auto",
  "deploy": {
    "install": "deno task install",
    "build": "deno task build && deno task pagefind",
    "runtime": {
      "type": "static",
      "cwd": "./dist"
    }
  },
  "unstable": [
    "sloppy-imports"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/http": "jsr:@std/http@^1.1.2",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.6"
  }
}
