/*
  Deno Deploy static server headers (staticd).
  First matching rule wins — specific paths must come before broad ones.
*/

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

/pagefind/*
  Cache-Control: public, max-age=604800

/*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://giscus.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://giscus.app; font-src 'self' https://fonts.gstatic.com https://giscus.app; img-src 'self' data: https:; connect-src 'self' https://giscus.app https://api.github.com; frame-src https://giscus.app; media-src 'self'; base-uri 'self'; form-action 'self'
