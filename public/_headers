/*
  Deno Deploy static server headers (staticd).
  First matching rule wins — specific paths must come before broad ones.
*/

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

/pagefind/*
  Cache-Control: public, max-age=604800

/*
  Cache-Control: no-cache
