---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/astro/Header.astro";
import Footer from "@/components/astro/Footer.astro";
import { Image } from "astro:assets";
import drinkImage from "@/assets/img/drink.webp";
import { SITE } from "@/config";

const backUrl = SITE.showBackButton ? `${Astro.url.pathname}` : "/";
---

<Layout
  title={`搜尋 | ${SITE.title}`}
  description="站內搜尋 Neko0xff 技術文章。"
  robots="noindex, nofollow"
>
  <Header />
  <Main pageTitle="搜尋" pageDesc="搜尋任何事物...">
    <div id="pagefind-search" transition:persist data-backurl={backUrl}>
      <form role="search" class="pagefind-form">
        <input
          type="search"
          class="pagefind-input"
          placeholder="搜尋文章...（按 / 快速聚焦）"
          aria-label="搜尋"
          autocomplete="off"
          aria-keyshortcuts="/"
        />
        <button
          type="button"
          class="pagefind-clear"
          aria-label="清除搜尋"
          hidden
        >
          ✕
        </button>
      </form>
      <div class="pagefind-results" aria-live="polite"></div>
    </div>
    <br />
    <Image
      src={drinkImage}
      alt=""
      aria-hidden="true"
      width={200}
      loading="lazy"
      class="mx-auto"
    />
  </Main>
  <Footer />
</Layout>

<script src="../utils/pageFindSearch.ts"></script>

<style is:global type="text/css">
  @import "../styles/search.css";
</style>
