import Links from "@/components/astro/Links.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
---

<Layout
  title={`友站鏈結 | ${SITE.title}`}
  description="Neko0xff 推薦的友站與技術部落格鏈結。"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "友站鏈結",
    description: "Neko0xff 推薦的友站與技術部落格鏈結。",
  }}
>
