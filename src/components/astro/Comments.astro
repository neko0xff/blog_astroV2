<div id="inject-comments" class="w-full"></div>

<script is:inline>
  (() => {
    let giscusReady = false;
    const container = document.getElementById("inject-comments");
    const script = document.createElement("script");
    const getTheme = () =>
      document.documentElement.getAttribute("data-theme") ||
      (window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light");
    const themeObserver = new MutationObserver(() => postTheme(getTheme()));
    const frameObserver = new MutationObserver(() => {
      const iframe = container.querySelector("iframe.giscus-frame");
      if (!iframe || giscusReady) return;
      const onLoad = () => {
        giscusReady = true;
        postTheme(getTheme()); // 載入後補送一次當前主題，避免競爭期間的切換遺失
      };
      iframe.addEventListener("load", onLoad, { once: true });
    });
    const postTheme = theme => {
      const iframe = container.querySelector("iframe.giscus-frame");
      if (!iframe) return;
      if (!giscusReady) return;

      try {
        iframe.contentWindow?.postMessage(
          { giscus: { setConfig: { theme } } },
          "https://giscus.app"
        );
      } catch {
        // iframe 仍處於導航中（因 origin 不符）時忽略，載入完成後會再同步
      }
    };

    // [Race Condition 防護]
    // 在 Giscus iframe 尚未完成跨域導向前，其 contentWindow 的 origin 仍為同源的 about:blank。
    // 若此時直接向 targetOrigin ("https://giscus.app") 發送 postMessage 會因 Origin 不匹配而被瀏覽器拒絕。
    // 採用 isReady 旗標來攔截載入過渡期（Transition State）的訊息傳送。

    if (!container) return;

    script.src = "https://giscus.app/client.js";
    script.async = true;
    script.crossOrigin = "anonymous";
    script.setAttribute("data-repo", "neko0xff/blog_astroV2");
    script.setAttribute("data-repo-id", "R_kgDOMkI6YA");
    script.setAttribute("data-category", "Announcements");
    script.setAttribute("data-category-id", "DIC_kwDOMkI6YM4CjZSo");
    script.setAttribute("data-mapping", "title");
    script.setAttribute("data-strict", "0");
    script.setAttribute("data-reactions-enabled", "1");
    script.setAttribute("data-emit-metadata", "0");
    script.setAttribute("data-input-position", "top");
    script.setAttribute("data-lang", "zh-TW");
    script.setAttribute("data-loading", "lazy");
    script.setAttribute("data-theme", getTheme());
    container.appendChild(script);

    // 當偵測 giscus iframe 建立，並在其 load 完成後才允許同步主題
    frameObserver.observe(container, { childList: true, subtree: true });

    // 主題切換時同步給 giscus（iframe 載入後才會真正送出）
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  })();
</script>
