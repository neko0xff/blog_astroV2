---
// Route label mapping
const ROUTE_LABELS: Record<string, string> = {
  posts: "文章",
  archives: "歸檔",
  about: "關於",
  terms: "條款",
  links: "友站連結",
  search: "搜尋",
  tags: "標籤",
};

// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1);

// RegExp-based path parser: extract route, segment and optional page number
// eg: /tags/tailwindcss/2 => { route: "tags", segment: "tailwindcss", page: "2" }
const routeMatch = currentUrlPath.match(
  /^\/(?<route>[^/]+)(?:\/(?<segment>[^/]+))?(?:\/(?<page>\d+))?$/
);

// Normalize route segments to display labels
if (routeMatch?.groups) {
  const { route, segment, page } = routeMatch.groups;

  switch (route) {
    // Paginated routes: /posts/2, /archives/3
    case "posts":
    case "archives":
      if (segment) {
        breadcrumbList.splice(
          0,
          2,
          `${ROUTE_LABELS[route]} (第 ${segment} 頁)`
        );
      } else {
        breadcrumbList[0] = ROUTE_LABELS[route];
      }
      break;

    // Tag routes: /tags, /tags/[tag], /tags/[tag]/2
    case "tags":
      if (page) {
        const pageLabel = Number(page) === 1 ? "" : `(第 ${page} 頁)`;
        breadcrumbList.splice(1, 3, `${segment} ${pageLabel}`);
      } else if (breadcrumbList.length === 1) {
        breadcrumbList[0] = ROUTE_LABELS.tags;
      }
      break;

    // Simple labeled routes: /about, /search, ...
    default:
      if (route in ROUTE_LABELS) {
        breadcrumbList[0] = ROUTE_LABELS[route];
      }
      break;
  }
}

// Build BreadcrumbList JSON-LD structured data
const baseUrl = Astro.url.origin;
const breadcrumbJsonLdItems: Array<{
  "@type": string;
  position: number;
  name: string;
  item: string;
}> = [];

// Reusable: map segment to display name using same rules as the UI
function getBreadcrumbDisplayName(segment: string): string {
  return ROUTE_LABELS[segment] ?? decodeURIComponent(segment);
}

// Build hierarchy from ORIGINAL URL segments (before label normalization)
const rawSegments = currentUrlPath.split("/").slice(1);
let accumulatedPath = "";
for (let i = 0; i < rawSegments.length; i++) {
  accumulatedPath += `/${rawSegments[i]}`;
  breadcrumbJsonLdItems.push({
    "@type": "ListItem",
    position: i + 2,
    name: getBreadcrumbDisplayName(rawSegments[i]),
    item: `${baseUrl}${accumulatedPath}/`,
  });
}
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "主頁",
        item: `${baseUrl}/`,
      },
      ...breadcrumbJsonLdItems,
    ],
  })}
/>

<nav class="mx-auto mt-8 mb-1 w-full max-w-3xl px-4" aria-label="breadcrumb">
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href="/" class="opacity-80">主頁</a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) => {
        const isLast = index === breadcrumbList.length - 1;
        const decoded = decodeURIComponent(breadcrumb);
        return isLast ? (
          <li>
            <span
              class={`capitalize opacity-75${index > 0 ? " lowercase" : ""}`}
              aria-current="page"
            >
              {decoded}
            </span>
          </li>
        ) : (
          <li>
            <a href={`/${breadcrumb}/`} class="capitalize opacity-70">
              {decoded}
            </a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        );
      })
    }
  </ul>
</nav>
<br />
